{
	"name": "o-pi",
	"engines": {
		"bun": ">=1.4.0"
	},
	"type": "module",
	"private": true,
	"scripts": {
		"build": "bun scripts/build.mjs",
		"typecheck": "tsc",
		"test": "bun run build && vitest run",
		"bench": "bun run build && bun scripts/bench.mjs",
		"dev:web": "bun run build:gui && bun src/web/cli.ts",
		"build:gui": "vite build --config vite.gui.config.ts",
		"build:web": "bun scripts/build-web.mjs",
		"build:desktop": "bun scripts/build-desktop.mjs",
		"desktop": "electron dist/desktop/app",
		"test:gui": "bun run build:web && bun scripts/build-desktop.mjs --dir && playwright test --config playwright.gui.config.ts"
	},
	"devDependencies": {
		"@earendil-works/pi-server": "latest",
		"@playwright/test": "latest",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "latest",
		"@types/node-notifier": "latest",
		"@types/picomatch": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@types/turndown": "latest",
		"@types/ws": "latest",
		"@vitest/coverage-v8": "latest",
		"electron": "latest",
		"electron-builder": "latest",
		"jiti": "latest",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "latest",
		"vite": "latest",
		"vitest": "latest"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "latest",
		"@earendil-works/pi-ai": "latest",
		"@earendil-works/pi-coding-agent": "latest",
		"@earendil-works/pi-tui": "latest",
		"@mathjax/mathjax-tex-font": "latest",
		"@mathjax/src": "latest",
		"@mozilla/readability": "latest",
		"@napi-rs/canvas": "latest",
		"@resvg/resvg-js": "latest",
