{
	"name": "o-pi",
	"engines": {
		"bun": ">=1.4.0"
	},
	"type": "module",
	"private": true,
	"scripts": {
		"build": "bun scripts/build.mjs",
		"build:tui": "bun scripts/build.mjs tui",
		"typecheck": "tsc",
		"test": "bun run build:tui && vitest run",
		"bench": "bun run build:tui && bun scripts/bench.mjs",
		"dev:tui": "bun src/tui/main.ts",
		"dev:web": "bun run build:gui && bun src/web/main.ts",
		"build:gui": "vite build --config vite.gui.config.ts",
		"build:web": "bun scripts/build.mjs web",
		"build:desktop": "bun scripts/build.mjs desktop",
		"desktop": "electron dist/desktop/app",
		"test:gui": "bun scripts/build.mjs web desktop --dir && playwright test --config playwright.gui.config.ts"
	},
	"devDependencies": {
		"@earendil-works/pi-server": "latest",
		"@playwright/test": "latest",
		"@tailwindcss/vite": "latest",
		"@types/node": "latest",
		"@types/node-notifier": "latest",
		"@types/picomatch": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@types/react-syntax-highlighter": "latest",
		"@types/turndown": "latest",
		"@types/ws": "latest",
		"@vitest/coverage-v8": "latest",
		"electron": "latest",
		"electron-builder": "latest",
		"jiti": "latest",
		"tailwindcss": "latest",
		"tw-animate-css": "latest",
		"typescript": "latest",
		"vite": "latest",
		"vitest": "latest"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "latest",
		"@earendil-works/pi-ai": "latest",
		"@earendil-works/pi-coding-agent": "latest",
		"@earendil-works/pi-tui": "latest",
		"@mathjax/mathjax-tex-font": "latest",
		"@mathjax/src": "latest",
		"@mozilla/readability": "latest",
		"@napi-rs/canvas": "latest",
