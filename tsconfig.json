{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"skipLibCheck": true,
		"types": ["node", "vitest"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"],
	"exclude": ["o-pet"]
}
