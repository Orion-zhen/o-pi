{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"default_model": { "title": "默认模型", "type": ["string", "null"], "pattern": "\\S" },
		"max_parallel_tasks": { "title": "最大并行任务数", "type": "integer", "minimum": 1, "maximum": 32 },
		"max_concurrency": { "title": "单任务并发数", "type": "integer", "minimum": 1, "maximum": 8 },
		"timeout_ms": { "title": "超时（毫秒）", "type": "integer", "minimum": 1000, "maximum": 3600000 },
		"retries": { "title": "重试次数", "type": "integer", "minimum": 0, "maximum": 5 },
		"retry_delay_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
		"retry_on_empty_output": { "title": "空输出时重试", "type": "boolean" },
		"retry_on_timeout": { "title": "超时时重试", "type": "boolean" },
		"max_inline_output_tokens": { "type": "integer", "minimum": 250, "maximum": 50000 },
		"max_handoff_tokens": { "type": "integer", "minimum": 250, "maximum": 50000 },
		"allow_project_agents": { "title": "允许项目子代理", "type": "boolean" },
		"project_agents_override_user": { "title": "项目定义优先", "type": "boolean" },
		"confirm_write_agents": { "title": "写入前确认", "type": "boolean" },
		"default_tools": {
			"title": "默认工具",
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "string", "pattern": "^[^,\\s]+$" }
		},
		"agent_overrides": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"model": { "type": "string", "pattern": "\\S" },
					"tools": {
						"type": "array",
						"minItems": 1,
						"uniqueItems": true,
						"items": { "type": "string", "pattern": "^[^,\\s]+$" }
					}
				}
			}
		}
	}
}
