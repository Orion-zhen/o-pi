{
	"$schema": "https://json-schema.org/draft-07/schema",
	"$id": "approval-gate.schema.json",
	"title": "Pi approval-gate config",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"enabled": { "title": "权限审批", "type": "boolean", "default": true },
		"ai_review": {
			"type": "object", "additionalProperties": false,
			"properties": {
				"enabled": { "title": "启用 AI 审批", "type": "boolean" },
				"model": { "title": "审批模型", "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[^/\\s]+/[^\\s]+$" }] },
				"thinking_level": { "title": "思考等级", "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] },
				"auto_apply_seconds": { "title": "自动采纳延迟（秒，0 不自动采纳）", "type": "integer", "minimum": 0, "maximum": 2147483, "default": 0 },
				"max_turns": { "title": "对话轮数上限", "type": "integer", "minimum": 1 },
				"max_tool_calls": { "title": "历史工具调用数上限", "type": "integer", "minimum": 0 }
			}
		},
		"ui": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"timeout_ms": { "title": "审批超时（毫秒，0 不超时）", "type": "integer", "minimum": 0, "maximum": 3600000, "default": 0 },
				"non_interactive": { "title": "非交互操作", "enum": ["block", "allow"], "default": "block" }
			}
		},
		"tools": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"shell": { "allOf": [{ "$ref": "#/$defs/shellPolicy" }], "properties": { "default_action": { "title": "执行 Shell" } } },
				"write": { "allOf": [{ "$ref": "#/$defs/filePolicy" }], "properties": { "default_action": { "title": "写入文件" } } },
				"edit": { "allOf": [{ "$ref": "#/$defs/filePolicy" }], "properties": { "default_action": { "title": "编辑文件" } } },
				"webfetch": { "allOf": [{ "$ref": "#/$defs/networkPolicy" }], "properties": { "default_action": { "title": "读取网页" } } }
			}
		}
	},
	"$defs": {
		"defaultAction": { "enum": ["allow", "ask", "deny"], "default": "allow" },
		"shellName": { "enum": ["bash", "powershell"], "description": "仅匹配指定 Shell。省略时两种 Shell 均可匹配。" },
		"factAction": { "enum": ["ask", "deny"] },
		"reason": { "type": "string", "minLength": 1, "description": "合并后，ask 和 deny 规则必须有非空白原因。询问时在审批界面展示，拒绝时返回给代理。" },
		"globs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
		"filePolicy": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"default_action": { "$ref": "#/$defs/defaultAction" },
				"facts": {
					"type": "object", "additionalProperties": false,
					"patternProperties": { "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$": { "anyOf": [{ "const": false }, { "$ref": "#/$defs/fileFact" }] } }
				}
			}
		},
		"networkPolicy": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"default_action": { "$ref": "#/$defs/defaultAction" },
				"facts": {
					"type": "object", "additionalProperties": false,
					"patternProperties": { "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$": { "anyOf": [{ "const": false }, { "$ref": "#/$defs/networkFact" }] } }
				}
			}
		},
		"shellPolicy": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"default_action": { "$ref": "#/$defs/defaultAction" },
				"facts": {
					"type": "object",
					"additionalProperties": false,
					"patternProperties": {
						"^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$": { "anyOf": [{ "const": false }, { "$ref": "#/$defs/shellFact" }] }
					}
				},
				"combinations": {
					"type": "object",
					"additionalProperties": {
						"anyOf": [
							{ "const": false },
							{ "$ref": "#/$defs/shellCombination" }
						]
					}
				}
			}
		},
		"fileFact": {
			"type": "object", "additionalProperties": false,
			"properties": {
				"action": { "$ref": "#/$defs/factAction" }, "reason": { "$ref": "#/$defs/reason" },
				"match_all": { "const": true }, "path_globs": { "$ref": "#/$defs/globs" }
			},
			"not": { "required": ["match_all", "path_globs"] }
		},
		"networkFact": {
			"type": "object", "additionalProperties": false,
			"properties": {
				"action": { "$ref": "#/$defs/factAction" }, "reason": { "$ref": "#/$defs/reason" },
				"match_all": { "const": true }, "network_scope": { "enum": ["public", "private", "loopback"] }
			},
			"not": { "required": ["match_all", "network_scope"] }
		},
		"shellFact": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"shell": { "$ref": "#/$defs/shellName" },
				"action": { "$ref": "#/$defs/factAction" },
				"reason": { "$ref": "#/$defs/reason" },
				"match_all": { "const": true },
				"path_globs": { "$ref": "#/$defs/globs" },
				"commands": {
					"type": "object",
					"additionalProperties": {
						"anyOf": [
							{ "const": false },
							{ "$ref": "#/$defs/shellCommandMatcher" }
						]
					}
				}
			},
			"if": { "required": ["match_all"] },
			"then": { "not": { "anyOf": [{ "required": ["commands"] }, { "required": ["path_globs"] }] } }
		},
		"commandPrefix": {
			"type": "array", "minItems": 1,
			"items": [{ "type": "string", "minLength": 1, "description": "程序基本名称的 glob。" }],
			"additionalItems": { "type": "string", "description": "一个字面参数。整项 * 匹配一个已有参数，{a,b} 匹配任一字面值。" }
		},
		"pipelineStage": {
			"anyOf": [
				{ "$ref": "#/$defs/commandPrefix" },
				{
					"type": "object", "additionalProperties": false, "required": ["command", "arg_globs"],
					"properties": { "command": { "$ref": "#/$defs/commandPrefix" }, "arg_globs": { "$ref": "#/$defs/globs" } }
				}
			]
		},
		"shellCommandMatcher": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"command": { "$ref": "#/$defs/commandPrefix" },
				"except": { "type": "array", "items": { "$ref": "#/$defs/commandPrefix" }, "description": "任一前缀确定匹配时，仅跳过当前候选的这条命令规则。空数组清除继承的例外。" },
				"exact": { "type": "boolean" },
				"arg_globs": { "$ref": "#/$defs/globs" },
				"pipeline": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/pipelineStage" } },
				"shell": { "$ref": "#/$defs/shellName" },
				"platform": { "enum": ["linux", "darwin", "win32"] }
			},
			"not": { "required": ["exact", "arg_globs"], "properties": { "exact": { "const": true } } },
			"if": { "required": ["pipeline"] },
			"then": { "not": { "anyOf": [{ "required": ["command"] }, { "required": ["exact"] }, { "required": ["arg_globs"] }, { "required": ["except"] }] } }
		},
		"shellCombination": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"shell": { "$ref": "#/$defs/shellName" },
				"all": {
					"type": "array",
					"minItems": 2,
					"uniqueItems": true,
					"items": { "type": "string", "minLength": 1 }
				},
				"action": { "$ref": "#/$defs/factAction" },
				"reason": { "$ref": "#/$defs/reason" }
			}
		}
	}
}
