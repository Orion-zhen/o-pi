{
	"$schema": "https://json-schema.org/draft-07/schema",
	"$id": "approval-gate.schema.json",
	"title": "Pi approval-gate config",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"enabled": { "type": "boolean", "default": true },
		"ui": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"timeout_ms": { "type": "integer", "minimum": 0, "maximum": 3600000, "default": 0 },
				"non_interactive": { "enum": ["block", "allow"], "default": "block" }
			}
		},
		"remember": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"allow_session": { "type": "boolean", "default": true },
				"allow_persistent": { "type": "boolean", "default": true },
				"persistent_store": { "type": "string", "minLength": 1, "default": "~/.pi/agent/state/approval-gate.rules.jsonc" }
			}
		},
		"tools": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"bash": { "$ref": "#/$defs/bashPolicy" },
				"write": { "$ref": "#/$defs/toolPolicy" },
				"edit": { "$ref": "#/$defs/toolPolicy" },
				"webfetch": { "$ref": "#/$defs/toolPolicy" }
			}
		},
		"ask_rules": {
			"type": "array",
			"items": { "$ref": "#/$defs/rule" },
			"default": []
		},
		"deny_rules": {
			"type": "array",
			"items": { "$ref": "#/$defs/rule" },
			"default": []
		}
	},
	"$defs": {
		"toolPolicy": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"default_action": { "enum": ["allow", "ask", "deny"] }
			}
		},
		"bashPolicy": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"default_action": { "enum": ["allow", "ask", "deny"], "default": "allow" },
				"facts": {
					"type": "object",
					"additionalProperties": false,
					"patternProperties": {
						"^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$": { "$ref": "#/$defs/bashFact" }
					}
				},
				"combinations": {
					"type": "object",
					"additionalProperties": {
						"anyOf": [
							{ "const": false },
							{ "$ref": "#/$defs/bashCombination" }
						]
					}
				}
			}
		},
		"bashFact": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"enabled": { "type": "boolean", "default": true },
				"action": { "enum": ["ask", "deny"] },
				"commands": {
					"type": "object",
					"additionalProperties": {
						"anyOf": [
							{ "type": "string", "minLength": 1 },
							{ "const": false },
							{ "$ref": "#/$defs/bashCommandMatcher" }
						]
					}
				}
			}
		},
		"bashCommandMatcher": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"regex": { "type": "string", "minLength": 1 },
				"scope": { "enum": ["raw-input", "source-unit", "effective-unit"], "default": "source-unit" },
				"platform": { "enum": ["linux", "darwin", "win32"] }
			}
		},
		"bashCombination": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"enabled": { "type": "boolean", "default": true },
				"all": {
					"type": "array",
					"minItems": 2,
					"uniqueItems": true,
					"items": { "type": "string", "minLength": 1 }
				},
				"action": { "enum": ["ask", "deny"] }
			}
		},
		"rule": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "tools", "reason"],
			"properties": {
				"name": { "type": "string", "minLength": 1 },
				"tools": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"path_globs": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"reason": { "type": "string", "minLength": 1 }
			}
		}
	}
}
