{
	"$schema": "https://json-schema.org/draft-07/schema",
	"$id": "file-tools.schema.json",
	"title": "Pi file-tools config",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"blocked_path": {
			"type": "array",
			"default": [".git/"],
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"ignored_path": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"limits": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"ls_entries": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10000,
					"default": 200
				},
				"read_lines": {
					"type": "integer",
					"minimum": 1,
					"maximum": 100000,
					"default": 2000
				},
				"read_bytes": {
					"type": "integer",
					"minimum": 1024,
					"maximum": 10485760,
					"default": 51200
				},
				"read_max_file_bytes": {
					"type": "integer",
					"minimum": 1024,
					"maximum": 104857600,
					"default": 16777216
				},
				"read_suggestion_limit": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10,
					"default": 3
				},
				"write_max_file_bytes": {
					"type": "integer",
					"minimum": 1024,
					"maximum": 104857600,
					"default": 16777216
				},
				"edit_max_file_bytes": {
					"type": "integer",
					"minimum": 1024,
					"maximum": 104857600,
					"default": 16777216
				},
				"edit_match_hint_limit": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10,
					"default": 3
				},
				"find_output_token_budget": {
					"type": "integer",
					"minimum": 32,
					"maximum": 10000,
					"default": 800
				},
				"find_result_limit": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10000,
					"default": 50
				},
				"find_max_depth": {
					"type": "integer",
					"minimum": 0,
					"maximum": 256,
					"default": 12
				},
				"grep_max_depth": {
					"type": "integer",
					"minimum": 0,
					"maximum": 256,
					"default": 12
				},
				"grep_ast_max_file_bytes": {
					"type": "integer",
					"minimum": 1024,
					"maximum": 104857600,
					"default": 262144
				},
				"grep_output_token_budget": {
					"type": "integer",
					"minimum": 100,
					"maximum": 10000,
					"default": 4000
				},
				"grep_result_limit": {
					"type": "integer",
					"minimum": 1,
					"maximum": 50,
					"default": 24
				},
				"grep_regional_display_limit": {
					"type": "integer",
					"minimum": 1,
					"maximum": 20,
					"default": 3
				}
			}
		},
		"ignore": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"piignore": {
					"type": "boolean",
					"default": true
				},
				"gitignore": {
					"type": "boolean",
					"default": true
				},
				"git_tracked_files_bypass": {
					"type": "boolean",
					"default": true
				},
				"builtin_profile": {
					"type": "string",
					"enum": ["none", "minimal", "performance"],
					"default": "minimal"
				}
			}
		}
	}
}
