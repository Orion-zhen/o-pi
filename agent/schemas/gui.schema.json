{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "GUI preferences",
	"type": "object",
	"additionalProperties": false,
	"$defs": {
		"fontChain": {
			"type": "array",
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" }
		}
	},
	"properties": {
		"$schema": { "type": "string" },
		"theme": { "enum": ["system", "light", "dark"] },
		"themeColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
		"fonts": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"ui": { "$ref": "#/$defs/fontChain" },
				"code": { "$ref": "#/$defs/fontChain" }
			}
		},
		"fontSizes": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"ui": { "type": "number", "minimum": 8, "maximum": 48 },
				"chat": { "type": "number", "minimum": 8, "maximum": 48 },
				"code": { "type": "number", "minimum": 8, "maximum": 48 }
			}
		},
		"sendShortcut": { "enum": ["mod-enter", "enter"] }
	}
}
