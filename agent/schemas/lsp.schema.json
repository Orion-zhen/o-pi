{
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"enabled": { "type": "boolean", "default": true },
		"exclude_paths": {
			"type": "array",
			"maxItems": 100,
			"default": [],
			"items": { "type": "string", "minLength": 1, "maxLength": 1024 },
			"uniqueItems": true
		},
		"startup_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000, "default": 8000 },
		"request_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000, "default": 5000 },
		"idle_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000, "default": 300000 },
		"max_open_documents": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 64 },
		"diagnostics": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"enabled": { "type": "boolean", "default": true },
				"max_wait_ms": { "type": "integer", "minimum": 0, "maximum": 60000, "default": 3000 },
				"settle_ms": { "type": "integer", "minimum": 0, "maximum": 5000, "default": 150 },
				"max_items": { "type": "integer", "minimum": 0, "maximum": 100, "default": 8 },
				"max_related_locations": { "type": "integer", "minimum": 0, "maximum": 10, "default": 2 },
				"min_severity": { "enum": ["error", "warning", "information", "hint"], "default": "warning" }
			}
		},
		"read": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"outline": { "type": "boolean", "default": true },
				"max_symbols": { "type": "integer", "minimum": 0, "maximum": 200, "default": 40 }
			}
		},
		"grep": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"workspace_symbols": { "type": "boolean", "default": true },
				"max_symbols": { "type": "integer", "minimum": 0, "maximum": 200, "default": 20 },
				"max_exact_leaf_symbols": { "type": "integer", "minimum": 0, "maximum": 200, "default": 2 }
			}
		},
		"servers": {
			"type": "object",
			"default": {},
			"patternProperties": {
				"^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
					"type": "object",
					"additionalProperties": false,
					"required": ["languages"],
					"properties": {
						"enabled": { "type": "boolean", "default": true },
						"fallback": { "type": "boolean", "default": false },
						"command": {
							"type": "array",
							"minItems": 1,
							"maxItems": 65,
							"items": { "type": "string", "minLength": 1, "maxLength": 512 }
						},
						"tcp": {
							"type": "object",
							"additionalProperties": false,
							"required": ["host", "port"],
							"properties": {
								"host": { "type": "string", "minLength": 1, "maxLength": 255 },
								"port": { "type": "integer", "minimum": 1, "maximum": 65535 }
							}
						},
						"languages": {
							"type": "object",
							"patternProperties": {
								"^\\S{1,128}$": {
									"anyOf": [
										{ "type": "string", "minLength": 1, "maxLength": 512 },
										{
											"type": "array",
											"minItems": 1,
											"maxItems": 64,
											"uniqueItems": true,
											"items": { "type": "string", "minLength": 1, "maxLength": 512 }
										}
									]
								}
							},
							"additionalProperties": false
						},
						"init": {},
						"settings": {}
					},
					"anyOf": [
						{ "required": ["command"] },
						{ "required": ["tcp"] }
					]
				}
			},
			"additionalProperties": false
		}
	}
}
