{
	"$schema": "../schemas/bash-tool.schema.json",
	"default_timeout_seconds": 300,
	"python_venv_paths": [
		".venv",
		"venv",
		"env",
		".env",
		"pyvenv",
		"pyenv",
		".pyvenv",
		".pyenv"
	],
	"environment": {
		"inherit": true,
		"remove_name_regex": [
			"(?:^|_)(?:TOKEN|SECRET|PASSWORD|PRIVATE_KEY|API_KEY|ACCESS_KEY|AUTH|CREDENTIALS)$",
			"^(?:DATABASE_URL|REDIS_URL|DOCKER_AUTH_CONFIG)$"
		],
		"expose_pi_session_file": false
	},
	"limits": {
		"success_output_bytes": 24576,
		"failure_output_bytes": 49152,
		"live_output_bytes": 8192,
		"max_capture_bytes": 268435456
	}
}
