{
	"$schema": "../schemas/approval-gate.schema.json",
	"enabled": true,
	"ui": {
		"timeout_ms": 0,
		"non_interactive": "block"
	},
	// 事实和组合按「领域.行为」命名，commands 下用局部短名。按 ID 覆盖字段，设为 false 可禁用。
	"tools": {
		"write": {
			"default_action": "allow",
			"facts": {
				"filesystem.write-system-path": {
					"action": "ask",
					"reason": "system path modification",
					"path_globs": ["/etc/**", "/usr/**", "/bin/**", "/sbin/**", "/System/**", "/Library/**", "/var/**"]
				}
			}
		},
		"edit": {
			"default_action": "allow",
			"facts": {
				"filesystem.write-system-path": {
					"action": "ask",
					"reason": "system path modification",
					"path_globs": ["/etc/**", "/usr/**", "/bin/**", "/sbin/**", "/System/**", "/Library/**", "/var/**"]
				}
			}
		},
		"webfetch": {
			"default_action": "allow",
			"facts": {
				"network.fetch-private": {
					"action": "ask",
					"network_scope": "private",
					"reason": "private network access"
				}
			}
		},
		"bash": {
			"default_action": "allow",
			"facts": {
				"filesystem.write-system-path": {
					"action": "ask",
					"reason": "system path argument to file-modifying command",
					"commands": {
						"file-operation": {
							"command": ["{tee,cp,mv,install,rm,mkdir,touch,chmod,chown}"],
							"arg_globs": ["/etc/**", "/usr/**", "/bin/**", "/sbin/**", "/System/**", "/Library/**", "/var/**"]
						}
					}
				},
				// 敏感信息读取与目录扫描。文件模式匹配整个参数，包括搜索词和紧贴选项的值。
				"credential.read": {
					"action": "deny",
					"reason": "Reading credential files can expose authentication secrets.",
					"commands": {
						"read-file": {
							"command": ["{cat,head,tail,sed,awk,grep,base64,xxd,strings}"],
							"arg_globs": [
								"**/*.ssh/id_*",
								"**/*.aws/credentials",
								"**/*application_default_credentials.json",
								"**/*.config/doctl/config.yaml",
								"**/*.kube/config",
								"**/*.docker/config.json",
								"**/*.azure/accessTokens.json",
								"**/*.npmrc",
								"**/*.pypirc",
								"**/*.netrc",
								"**/*.wrangler/config/default.toml",
								"**/*.config/gh/hosts.yml",
								"**/*auth-dir/**/*.json"
							]
						}
					}
				},
				"history.read": {
					"action": "deny",
					"reason": "Shell history may contain credentials or private commands.",
					"commands": {
						"read-file": {
							"command": ["{cat,head,tail,sed,awk,grep,base64,xxd,strings}"],
							"arg_globs": ["**/*.bash_history", "**/*.zsh_history"]
						}
					}
				},
				"environment.read-all": {
					"action": "ask",
					"reason": "Listing all environment variables may reveal tokens or passwords.",
					"commands": {
						"list-all": { "command": ["{env,printenv}"], "exact": true }
					}
				},
				"configuration.read-sensitive": {
					"action": "ask",
					"reason": "This command may read configuration containing secrets.",
					"commands": {
						// 只排除以 .env.example、.env.sample 或 .env.template 结尾的模板名。
						"read-file": {
							"command": ["{cat,head,tail,sed,awk,grep,base64,xxd,strings}"],
							"arg_globs": [
								"**/*.env",
								"**/*.env.!(example|sample|template)",
								"**/*.config/codex/config.toml",
								"**/*.codexrc"
							]
						},
						"find-env-to-cat": {
							"pipeline": [
								{
									"command": ["find"],
									"arg_globs": ["**/*.env!(.example|.sample|.template)", "**/*.env*/**"]
								},
								["xargs", "cat"]
							]
						}
					}
				},
				"host.scan-broad": {
					"action": "ask",
					"reason": "This search may list files outside the project.",
					"commands": {
						"find-roots": { "command": ["find", "{/,/home,/root}"] }
					}
				},
				// 对外传输：远程连接、文件传输、推送与发布。
				"network.write-external": {
					"action": "ask",
					"reason": "This command may send data or change content on a remote host.",
					"commands": {
						"remote-connection": { "command": ["{ssh,nc,ncat,socat}"] },
						"file-transfer": { "command": ["{scp,sftp}"] },
						"remote-rsync": { "command": ["rsync"], "arg_globs": ["**/*:*", "**/*:*/**"] },
						// curl 在 -- 之前按选项前缀匹配，包括 --data-binary 和紧贴短选项的值。
						"curl-upload": { "command": ["curl", "{--data,--form,--upload-file,-F,-T,-d}"] },
						"wget-upload": { "command": ["wget", "{--post-data,--post-file,--method}"] },
						"git-push": { "command": ["git", "push"] },
						"container-push": { "command": ["{docker,podman}", "push"] },
						"container-image-push": { "command": ["{docker,podman}", "image", "push"] },
						"gh-release": { "command": ["gh", "release", "{create,delete,edit,upload}"] },
						"package-publish": { "command": ["{npm,pnpm,yarn,cargo}", "publish"] },
						"twine": { "command": ["twine", "upload"] }
					}
				},
				// 强制递归删除、仓库清理与重置、容器系统清理。
				"filesystem.discard-data": {
					"action": "ask",
					"reason": "This operation may delete data or discard uncommitted changes.",
					"commands": {
						"rm-recursive-force": { "command": ["rm", "{-r,-R,--recursive}", "{-f,--force}"] },
						"git-clean-force": { "command": ["git", "clean", "-f"], "except": [["git", "clean", "{-n,--dry-run}"]] },
						"git-reset-hard": { "command": ["git", "reset", "--hard"] },
						"container-system-prune": { "command": ["{docker,podman}", "system", "prune"] }
					}
				},
				// 分析器另识别后台递归管道。
				"system.disrupt-host": {
					"action": "deny",
					"reason": "This operation can damage the host or exhaust its resources.",
					"commands": {
						"rm-root": { "command": ["rm", "{-r,-R,--recursive}", "{-f,--force}", "/"] },
						"chmod-root": { "command": ["chmod", "{-R,--recursive}", "777", "/"] },
						"chown-root": { "command": ["chown", "{-R,--recursive}", "/"] },
						"device-overwrite": { "command": ["dd"], "arg_globs": ["of=/dev/**"] },
						"format": { "command": ["{mkfs,mkfs.*}"] }
					}
				},
				// 管道按顺序匹配，两个阶段之间可以有其他命令。
				"shell.run-downloaded-script": {
					"action": "deny",
					"reason": "Downloaded content must not be piped directly into a shell.",
					"commands": {
						"download-to-shell": { "pipeline": [["{curl,wget}"], ["{sh,bash,zsh,fish}"]] }
					}
				},
				"package.change": {
					"action": "ask",
					"reason": "This command may install, remove or update software.",
					"commands": {
						// JavaScript
						"npm-pnpm": { "command": ["{npm,pnpm}", "{add,ci,i,install,remove,rm,uninstall,up,update,upgrade}"] },
						"bun": { "command": ["bun", "{a,add,ci,i,install,remove,rm,uninstall,up,update,upgrade}"] },
						"yarn": { "command": ["yarn", "{add,install,remove,up,upgrade}"] },
						"yarn-default-install": { "command": ["yarn"], "exact": true },
						// Python
						"pip": { "command": ["{pip,pip3}", "{install,uninstall}"] },
						"uv": { "command": ["uv", "{add,remove}"] },
						"uv-pip": { "command": ["uv", "pip", "{install,uninstall}"] },
						"uv-tool-python": { "command": ["uv", "{tool,python}", "{install,uninstall,upgrade}"] },
						"uv-self": { "command": ["uv", "self", "update"] },
						// Rust、Ruby、Go
						"cargo": { "command": ["cargo", "{add,install,remove,rm,uninstall,update}"] },
						"gem": { "command": ["gem", "{i,install,uninstall,update}"] },
						"go": { "command": ["go", "install"] },
						// 系统软件包
						"brew": { "command": ["brew", "{install,remove,rm,uninstall,up,update,upgrade}"] },
						"brew-bundle": { "command": ["brew", "bundle", "{add,install,remove}"] },
						"apt": { "command": ["{apt,apt-get}", "{install,remove,update,upgrade,dist-upgrade,full-upgrade}"] },
						"dnf-yum": { "command": ["{dnf,yum}", "{install,remove,rm,up,update,upgrade}"] },
						"dnf-yum-group": { "command": ["{dnf,yum}", "group", "{install,remove,upgrade}"] },
						"dnf-yum-module": { "command": ["{dnf,yum}", "module", "{install,remove,update}"] },
						"pacman": { "command": ["pacman", "{-S,-R,-U}"] }
					}
				},
				// 提权、服务与基础设施变更。
				"privilege.escalate": {
					"action": "ask",
					"reason": "This command requests privileges beyond the current account.",
					"commands": {
						"sudo": { "command": ["sudo"] }
					}
				},
				"service.change": {
					"action": "ask",
					"reason": "This command may interrupt a service or change its configuration.",
					"commands": {
						"systemctl-operation": {
							"command": ["systemctl", "*"],
							"except": [
								["systemctl", "{cat,get-default,get-property,help,is-active,is-enabled,is-failed}"],
								[
									"systemctl",
									"{list-dependencies,list-jobs,list-machines,list-sockets,list-timers,list-unit-files,list-units}"
								],
								["systemctl", "{show,show-environment,status}"]
							]
						},
						"launchctl-operation": {
							"command": ["launchctl", "*"],
							"except": [
								[
									"launchctl",
									"{blame,error,getenv,help,hostinfo,list,managername,managerpid,manageruid,print,print-cache,procinfo}"
								]
							]
						},
						"service-operation": { "command": ["service", "*", "*"], "except": [["service", "*", "status"]] },
						"service-restart-all": { "command": ["service", "--full-restart-all"] }
					}
				},
				"infrastructure.change": {
					"action": "ask",
					"reason": "This command may change or remove containers or deployed resources.",
					"commands": {
						"container-remove": {
							"command": ["{docker,podman}"],
							"arg_globs": ["rm", "prune"],
							"except": [
								["{docker,podman}", "{inspect,ps,logs,images,history,info,stats,top,version,push}"],
								["{docker,podman}", "image", "push"]
							]
						},
						"kubectl": { "command": ["kubectl"], "arg_globs": ["apply", "delete"] },
						"terraform": { "command": ["terraform"], "arg_globs": ["apply", "destroy"] }
					}
				},
				// 无法可靠解析的 Shell 输入由分析器标记。
				"shell.run-opaque-input": {
					"action": "ask",
					"reason": "The shell command's effects cannot be determined before execution.",
					"commands": {
						"eval": { "command": ["eval"] }
					}
				}
			},
			// 同一次调用既收集信息又对外传输时，直接拒绝。
			"combinations": {
				"environment.exfiltrate": {
					"reason": "Listing the environment alongside an external transfer risks exposing secrets.",
					"all": ["environment.read-all", "network.write-external"],
					"action": "deny"
				},
				"configuration.exfiltrate": {
					"reason": "Reading sensitive configuration alongside an external transfer risks exposing secrets.",
					"all": ["configuration.read-sensitive", "network.write-external"],
					"action": "deny"
				},
				"host.exfiltrate-scan-results": {
					"reason": "A broad filesystem scan alongside an external transfer risks exposing host data.",
					"all": ["host.scan-broad", "network.write-external"],
					"action": "deny"
				}
			}
		}
	}
}