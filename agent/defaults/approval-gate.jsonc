{
	"$schema": "../schemas/approval-gate.schema.json",
	"enabled": true,

	"ui": {
		"timeout_ms": 0,
		"non_interactive": "block"
	},

	"remember": {
		"allow_session": true,
		"allow_persistent": true,
		"persistent_store": "~/.pi/agent/state/approval-gate.rules.jsonc"
	},

	"defaults": {
		"bash": "allow",
		"write": "allow",
		"edit": "allow"
	},

	"ask_rules": [
		{
			"name": "system-path-write",
			"tools": ["bash", "write", "edit"],
			"path_globs": ["/etc/**", "/usr/**", "/bin/**", "/sbin/**", "/System/**", "/Library/**", "/var/**"],
			"reason": "system path modification"
		},
		{
			"name": "destructive-bash",
			"tools": ["bash"],
			"effects": ["destructive"],
			"reason": "destructive command"
		},
		{
			"name": "package-management",
			"tools": ["bash"],
			"effects": ["install"],
			"reason": "package management"
		},
		{
			"name": "external-publish",
			"tools": ["bash"],
			"effects": ["publish"],
			"reason": "external publishing"
		},
		{
			"name": "service-management",
			"tools": ["bash"],
			"effects": ["system_change"],
			"reason": "system-level command"
		},
		{
			"name": "infra-side-effect",
			"tools": ["bash"],
			"effects": ["external_side_effect"],
			"reason": "infrastructure side effect"
		},
		{
			"name": "opaque-shell-effect",
			"tools": ["bash"],
			"effects": ["unknown_side_effect"],
			"reason": "dynamic or unparsable shell side effect"
		}
	],

	"deny_rules": []
}
