{
	"$schema": "../schemas/approval-gate.schema.json",
	"enabled": true,
	"ui": {
		"timeout_ms": 0,
		"non_interactive": "block"
	},
	// 用户配置按 ID 覆盖，只需写要修改的字段。将事实、命令规则或组合设为 false 即可禁用。
	"tools": {
		"write": {
			"default_action": "allow",
			"facts": {
				"system-path-write": {
					"action": "ask",
					"reason": "system path modification",
					"path_globs": [
						"/etc/**",
						"/usr/**",
						"/bin/**",
						"/sbin/**",
						"/System/**",
						"/Library/**",
						"/var/**"
					]
				}
			}
		},
		"edit": {
			"default_action": "allow",
			"facts": {
				"system-path-write": {
					"action": "ask",
					"reason": "system path modification",
					"path_globs": [
						"/etc/**",
						"/usr/**",
						"/bin/**",
						"/sbin/**",
						"/System/**",
						"/Library/**",
						"/var/**"
					]
				}
			}
		},
		"webfetch": {
			"default_action": "allow",
			"facts": {
				"private-network-fetch": {
					"action": "ask",
					"network_scope": "private",
					"reason": "private network access"
				}
			}
		},
		"bash": {
			"default_action": "allow",
			"facts": {
				"system-path-write": {
					"action": "ask",
					"reason": "system path argument to file-modifying command",
					"commands": {
						"file-operation": {
							"command": [
								"{tee,cp,mv,install,rm,mkdir,touch,chmod,chown}"
							],
							"arg_globs": [
								"/etc/**",
								"/usr/**",
								"/bin/**",
								"/sbin/**",
								"/System/**",
								"/Library/**",
								"/var/**"
							]
						}
					}
				},
				// 按整个参数匹配，不区分文件名、搜索词和选项值。文件模式也覆盖紧贴选项的值。
				// 分析器也识别 find 查找 .env 后经管道交给 xargs cat 的情况。
				"credential.read": {
					"action": "deny",
					"commands": {
						"read-file": {
							"command": [
								"{cat,head,tail,sed,awk,grep,base64,xxd,strings}"
							],
							"arg_globs": [
								"**/*.ssh/id_*",
								"**/*.aws/credentials",
								"**/*application_default_credentials.json",
								"**/*.config/doctl/config.yaml",
								"**/*.kube/config",
								"**/*.docker/config.json",
								"**/*.azure/accessTokens.json",
								"**/*.npmrc",
								"**/*.pypirc",
								"**/*.netrc",
								"**/*.wrangler/config/default.toml",
								"**/*.config/gh/hosts.yml",
								"**/*auth-dir/**/*.json",
								"**/*.env",
								"**/*.env.*"
							]
						}
					}
				},
				"history.read": {
					"action": "deny",
					"commands": {
						"read-file": {
							"command": [
								"{cat,head,tail,sed,awk,grep,base64,xxd,strings}"
							],
							"arg_globs": [
								"**/*.bash_history",
								"**/*.zsh_history"
							]
						}
					}
				},
				"environment.read-all": {
					"action": "ask",
					"commands": {
						"env": {
							"command": [
								"env"
							],
							"exact": true
						},
						"printenv": {
							"command": [
								"printenv"
							],
							"exact": true
						}
					}
				},
				"configuration.read-sensitive": {
					"action": "ask",
					"commands": {
						"read-file": {
							"command": [
								"{cat,head,tail,sed,awk,grep,base64,xxd,strings}"
							],
							"arg_globs": [
								"**/*.config/codex/config.toml",
								"**/*.codexrc"
							]
						}
					}
				},
				"host.scan-broad": {
					"action": "ask",
					"commands": {
						"root": {
							"command": [
								"find",
								"/"
							]
						},
						"home": {
							"command": [
								"find",
								"/home"
							]
						},
						"root-home": {
							"command": [
								"find",
								"/root"
							]
						}
					}
				},
				// 分析器另识别 curl/wget 上传选项、远程 rsync、Git/Docker 推送和 gh release 变更。
				"network.external-write": {
					"action": "ask",
					"commands": {
						"scp": {
							"command": [
								"scp"
							]
						},
						"sftp": {
							"command": [
								"sftp"
							]
						},
						"nc": {
							"command": [
								"nc"
							]
						},
						"ncat": {
							"command": [
								"ncat"
							]
						},
						"socat": {
							"command": [
								"socat"
							]
						},
						"ssh": {
							"command": [
								"ssh"
							]
						},
						"twine": {
							"command": [
								"twine",
								"upload"
							]
						},
						"npm": {
							"command": [
								"npm",
								"publish"
							]
						},
						"pnpm": {
							"command": [
								"pnpm",
								"publish"
							]
						},
						"yarn": {
							"command": [
								"yarn",
								"publish"
							]
						},
						"cargo": {
							"command": [
								"cargo",
								"publish"
							]
						}
					}
				},
				// 分析器另识别递归强制删除、Git 强制清理和硬重置、Docker 系统清理。
				"filesystem.destructive": {
					"action": "ask",
					"commands": {
						"rmdir": {
							"command": [
								"rmdir"
							]
						}
					}
				},
				// 分析器另识别针对根目录的递归破坏操作和后台递归管道。
				"system.catastrophic": {
					"action": "deny",
					"commands": {
						"device-overwrite": {
							"command": [
								"dd"
							],
							"arg_globs": [
								"of=/dev/**"
							]
						},
						"format": {
							"command": [
								"{mkfs,mkfs.*}"
							]
						}
					}
				},
				// 分析器另识别经过中间命令的下载执行管道。
				"execution.remote-script": {
					"action": "deny",
					"commands": {
						"download-to-shell": {
							"pipeline": [
								[
									"{curl,wget}"
								],
								[
									"{sh,bash,zsh,fish}"
								]
							]
						}
					}
				},
				// 分析器另识别 pacman 的 -S、-R、-U 及其组合短选项。
				"package.change": {
					"action": "ask",
					"commands": {
						"go-install": {
							"command": [
								"go",
								"install"
							]
						},
						"package-manager": {
							"command": [
								"{apt,apt-get,brew,cargo,dnf,gem,npm,pip,pip3,pnpm,uv,yarn,yum}"
							],
							"arg_globs": [
								"add",
								"ci",
								"dist-upgrade",
								"full-upgrade",
								"i",
								"install",
								"remove",
								"rm",
								"uninstall",
								"update",
								"upgrade"
							]
						}
					}
				},
				"privilege.escalation": {
					"action": "ask",
					"commands": {
						"sudo": {
							"command": [
								"sudo"
							]
						}
					}
				},
				// 分析器另识别 systemctl、launchctl、service 的非查询操作和 Windows PowerShell 服务变更。
				"service.change": {
					"action": "ask",
					"commands": {
						"service-restart-all": {
							"command": [
								"service",
								"--full-restart-all"
							]
						},
						"sc-start": {
							"platform": "win32",
							"command": [
								"sc",
								"start"
							]
						},
						"sc-stop": {
							"platform": "win32",
							"command": [
								"sc",
								"stop"
							]
						},
						"sc-config": {
							"platform": "win32",
							"command": [
								"sc",
								"config"
							]
						},
						"sc-exe-start": {
							"platform": "win32",
							"command": [
								"sc.exe",
								"start"
							]
						},
						"sc-exe-stop": {
							"platform": "win32",
							"command": [
								"sc.exe",
								"stop"
							]
						},
						"sc-exe-config": {
							"platform": "win32",
							"command": [
								"sc.exe",
								"config"
							]
						}
					}
				},
				// 分析器另识别 Docker 的 rm 和 prune 操作。
				"infrastructure.change": {
					"action": "ask",
					"commands": {
						"kubectl": {
							"command": [
								"kubectl"
							],
							"arg_globs": [
								"apply",
								"delete"
							]
						},
						"terraform": {
							"command": [
								"terraform"
							],
							"arg_globs": [
								"apply",
								"destroy"
							]
						}
					}
				},
				// 无法可靠解析的 Shell 输入由分析器标记。
				"execution.opaque": {
					"action": "ask",
					"commands": {
						"eval": {
							"command": [
								"eval"
							]
						}
					}
				}
			},
			"combinations": {
				"environment-exfiltration": {
					"all": [
						"environment.read-all",
						"network.external-write"
					],
					"action": "deny"
				},
				"configuration-exfiltration": {
					"all": [
						"configuration.read-sensitive",
						"network.external-write"
					],
					"action": "deny"
				},
				"broad-scan-exfiltration": {
					"all": [
						"host.scan-broad",
						"network.external-write"
					],
					"action": "deny"
				}
			}
		}
	}
}