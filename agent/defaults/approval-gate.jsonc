{
	"$schema": "../schemas/approval-gate.schema.json",
	"enabled": true,
	"ui": {
		"timeout_ms": 0,
		"non_interactive": "block"
	},
	"remember": {
		"allow_session": true,
		"allow_persistent": true,
		"persistent_store": "~/.pi/agent/state/approval-gate.rules.jsonc"
	},
	"ask_rules": [
		{
			"name": "skill-modification",
			"tools": [
				"write",
				"edit"
			],
			"path_globs": [
				"skill://**"
			],
			"reason": "skill modification"
		},
		{
			"name": "system-path-write",
			"tools": [
				"bash",
				"write",
				"edit"
			],
			"path_globs": [
				"/etc/**",
				"/usr/**",
				"/bin/**",
				"/sbin/**",
				"/System/**",
				"/Library/**",
				"/var/**"
			],
			"reason": "system path modification"
		}
	],
	"deny_rules": [],
	"tools": {
		"bash": {
			"default_action": "allow",
			"facts": {
				"credential.read": {
					"action": "deny",
					"commands": {
						// 读取常见凭据文件。例如：cat ~/.ssh/id_rsa、grep token ./.env、base64 ~/.aws/credentials。
						"credential-files": "^(?:cat|head|tail|sed|awk|grep|base64|xxd|strings)\\b[\\s\\S]*(?:\\.ssh[/\\\\]id_|\\.aws[/\\\\]credentials|application_default_credentials\\.json|\\.config[/\\\\]doctl[/\\\\]config\\.yaml|\\.kube[/\\\\]config|\\.docker[/\\\\]config\\.json|\\.azure[/\\\\]accessTokens\\.json|\\.npmrc|\\.pypirc|\\.netrc|\\.wrangler[/\\\\]config[/\\\\]default\\.toml|\\.config[/\\\\]gh[/\\\\]hosts\\.yml|auth-dir[/\\\\][^\\s]*\\.json|(?:^|[/\\\\])\\.env(?:\\.[^\\s/]*)?)",
						// 批量查找并读取 .env 文件。例如：find . -name .env | xargs cat。
						"dotenv-bulk-read": {
							"scope": "raw-input",
							"regex": "find\\b[\\s\\S]*\\.env[\\s\\S]*\\|[\\s\\S]*xargs\\s+cat\\b"
						}
					}
				},
				"history.read": {
					"action": "deny",
					"commands": {
						// 读取 Shell 历史。例如：cat ~/.bash_history、grep token ~/.zsh_history。
						"shell-history": "^(?:cat|head|tail|sed|awk|grep|base64|xxd|strings)\\b[\\s\\S]*\\.(?:bash_history|zsh_history)"
					}
				},
				"environment.read-all": {
					"action": "ask",
					"commands": {
						// 输出完整进程环境。例如：env、printenv。读取单个变量不会命中。
						"full-environment": "^(?:env|printenv)\\s*$"
					}
				},
				"configuration.read-sensitive": {
					"action": "ask",
					"commands": {
						// 读取可能包含密钥的服务或代理配置。例如：cat config.yaml、grep api_key ~/.codexrc。
						"service-config": "^(?:cat|head|tail|sed|awk|grep)\\b[\\s\\S]*(?:config\\.ya?ml|\\.config[/\\\\]codex[/\\\\]config\\.toml|\\.codexrc)"
					}
				},
				"host.scan-broad": {
					"action": "ask",
					"commands": {
						// 从主机级根目录开始广泛扫描。例如：find / -name '*.pem'、find /home -type f。
						"find-host-roots": "^find\\s+(?:/|/root|/home)(?:\\s|$)"
					}
				},
				"network.external-write": {
					"action": "ask",
					"commands": {
						// 使用 curl 发送数据或上传文件。例如：curl -F file=@a.txt URL、curl --data @body.json URL。
						"curl-upload": {
							"scope": "effective-unit",
							"regex": "^curl\\b[\\s\\S]*(?:--data|--form|--upload-file|-F|-T)(?:[^\\s]*)(?:\\s|=)"
						},
						// 使用 wget 发送请求正文。例如：wget --post-file=body.json URL、wget --method=PUT URL。
						"wget-upload": {
							"scope": "effective-unit",
							"regex": "^wget\\b[\\s\\S]*(?:--post-data|--post-file|--method)"
						},
						// 向远端复制文件。例如：scp build.tgz host:/tmp/、rsync dist/ host:/srv/app/。
						"remote-copy": "^(?:scp|sftp)\\b|^rsync\\b[\\s\\S]*(?:[^\\s]+:|rsync://)",
						// 建立原始网络连接。例如：nc example.com 9000、socat - TCP:example.com:443。
						"raw-socket": "^(?:nc|ncat|socat)\\b",
						// 建立 SSH 会话或执行远程命令。例如：ssh host、ssh host deploy.sh。
						"ssh": "^ssh\\b",
						// 发布代码、镜像或制品。例如：git push、gh release create v1、docker push app:latest、npm publish。
						"publish": {
							"scope": "effective-unit",
							"regex": "^(?:git\\b[\\s\\S]*\\spush|gh\\b[\\s\\S]*\\srelease\\s+(?:create|delete|edit|upload)|twine\\s+upload|docker\\b[\\s\\S]*\\spush|(?:npm|pnpm|yarn|cargo)\\s+publish)(?:\\s|$)"
						}
					}
				},
				"filesystem.destructive": {
					"action": "ask",
					"commands": {
						// 执行破坏性文件操作。例如：rm -rf build、rmdir old、git reset --hard、git clean -fd。
						"destructive-command": {
							"scope": "effective-unit",
							"regex": "^(?:rmdir\\b|rm\\b(?=[\\s\\S]*\\s-[^\\s]*[rR])(?=[\\s\\S]*\\s-[^\\s]*f)|git\\b[\\s\\S]*(?:\\sclean\\b[\\s\\S]*\\s-[^\\s]*f|\\sreset\\b[\\s\\S]*\\s--hard)|docker\\b[\\s\\S]*\\ssystem\\s+prune)"
						}
					}
				},
				"system.catastrophic": {
					"action": "deny",
					"commands": {
						// 递归强制删除文件系统根。例如：rm -rf /。
						"root-delete": "\\brm\\s+-rf\\s+/(?:\\s|$)",
						// 格式化文件系统。例如：mkfs.ext4 /dev/sdb1。
						"filesystem-format": "\\bmkfs(?:\\.|\\s|$)",
						// 使用 dd 覆盖块设备。例如：dd if=image.iso of=/dev/sdb。
						"device-overwrite": "\\bdd\\s+[\\s\\S]*\\bof=/dev/",
						// 经典 Bash fork bomb。例如：:(){ :|:& };:。
						"fork-bomb": ":\\(\\)\\s*\\{\\s*:\\|:\\s*&\\s*\\}\\s*;",
						// 递归放宽根目录权限或更改所有者。例如：chmod -R 777 /、chown -R user /。
						"root-permissions": "\\b(?:chmod\\s+-R\\s+777|chown\\s+-R\\s+[^\\s]+)\\s+/(?:\\s|$)"
					}
				},
				"execution.remote-script": {
					"action": "deny",
					"commands": {
						// 下载内容后直接交给 Shell 执行。例如：curl URL | sh、wget -qO- URL | bash。
						"download-pipe-shell": {
							"scope": "raw-input",
							"regex": "\\b(?:curl|wget)\\b[\\s\\S]*\\|\\s*(?:sh|bash|zsh)\\b"
						}
					}
				},
				"package.change": {
					"action": "ask",
					"commands": {
						// 安装、删除或更新软件包。例如：npm install、pip uninstall x、apt upgrade、go install pkg@latest。
						"package-manager": {
							"scope": "effective-unit",
							"regex": "^(?:(?:apt|apt-get|brew|cargo|dnf|gem|npm|pip|pip3|pnpm|uv|yarn|yum)\\b[\\s\\S]*\\s(?:add|ci|dist-upgrade|full-upgrade|i|install|remove|rm|uninstall|update|upgrade)(?:\\s|$)|go\\s+install(?:\\s|$)|pacman\\b[\\s\\S]*\\s-[^\\s]*[SRU][^\\s]*)"
						}
					}
				},
				"privilege.escalation": {
					"action": "ask",
					"commands": {
						// 使用 sudo 提升权限。例如：sudo npm install、sudo systemctl restart nginx。
						"sudo": "^sudo(?:\\s|$)"
					}
				},
				"service.change": {
					"action": "ask",
					"commands": {
						// 改变或无法确认是否改变 systemd 状态。例如：systemctl restart nginx。status、show 等只读命令不命中。
						"systemctl": "^systemctl\\b(?:(?:\\s+(?:-H|-M|--host|--image|--machine|--root)\\s+\\S+)|(?:\\s+(?!(?:-H|-M|--host|--image|--machine|--root)(?:\\s|$))-\\S+))*\\s+(?!(?:-\\S+|cat|get-default|get-property|help|is-active|is-enabled|is-failed|list-dependencies|list-jobs|list-machines|list-sockets|list-timers|list-unit-files|list-units|show|show-environment|status)(?:\\s|$))\\S+",
						// 通过 service 改变服务状态。例如：service nginx restart、service --full-restart-all。status 不命中。
						"service": "^service(?:\\s+--full-restart-all(?:\\s|$)|\\s+\\S+\\s+(?!status(?:\\s|$))\\S+)",
						// 改变或无法确认是否改变 launchd 状态。例如：launchctl unload service.plist。list、print 等只读命令不命中。
						"launchctl": "^launchctl\\b(?:\\s+-\\S+)*\\s+(?!(?:-\\S+|blame|error|getenv|help|hostinfo|list|managername|managerpid|manageruid|print|print-cache|procinfo)(?:\\s|$))\\S+",
						// 在 Windows 上改变服务状态。例如：sc.exe stop Spooler、powershell Stop-Service Spooler。
						"windows-service": {
							"platform": "win32",
							"regex": "^(?:sc(?:\\.exe)?\\s+(?:start|stop|config)|powershell(?:\\.exe)?\\b[\\s\\S]*\\b(?:Start|Stop|Restart)-Service\\b)"
						}
					}
				},
				"infrastructure.change": {
					"action": "ask",
					"commands": {
						// 改变基础设施或容器状态。例如：kubectl apply、terraform destroy、docker rm container-id。
						"infra-tool": {
							"scope": "effective-unit",
							"regex": "^(?:kubectl\\b[\\s\\S]*\\s(?:apply|delete)|terraform\\b[\\s\\S]*\\s(?:apply|destroy)|docker\\b[\\s\\S]*\\s(?:rm|prune|system\\s+prune|container\\s+rm))(?:\\s|$)"
						}
					}
				},
				"execution.opaque": {
					"action": "ask",
					"commands": {
						// 无法可靠确定实际命令。例如：eval "$SCRIPT"、"$COMMAND" arg、bash -c "$SCRIPT"、语法错误输入。
						"dynamic-or-opaque": {
							"scope": "effective-unit",
							"regex": "^(?:<opaque>|<dynamic>(?:\\s|$)|eval(?:\\s|$)|(?:bash|dash|ksh|sh|zsh)\\b[\\s\\S]*\\s-[^\\s]*c[^\\s]*\\s+<dynamic>(?:\\s|$))"
						}
					}
				}
			},
			"combinations": {
				// 同一次调用既读取完整环境又向外发送数据时拒绝。例如：env | curl --data-binary @- URL。
				"environment-exfiltration": {
					"all": [
						"environment.read-all",
						"network.external-write"
					],
					"action": "deny"
				},
				// 同一次调用既读取敏感配置又向外发送数据时拒绝。例如：cat config.yaml | nc host 9000。
				"configuration-exfiltration": {
					"all": [
						"configuration.read-sensitive",
						"network.external-write"
					],
					"action": "deny"
				},
				// 同一次调用既广泛扫描主机又向外发送数据时拒绝。例如：find / -type f | curl --data-binary @- URL。
				"broad-scan-exfiltration": {
					"all": [
						"host.scan-broad",
						"network.external-write"
					],
					"action": "deny"
				}
			}
		},
		"write": {
			"default_action": "allow"
		},
		"edit": {
			"default_action": "allow"
		}
	}
}
