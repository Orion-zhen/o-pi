{
	"$schema": "../schemas/tui.schema.json",
	"enabled": true,
	"preset": "compact",
	"icons": "nerd",
	"chrome": {
		"title": true,
		"header": false,
		"footer": true,
		"working_indicator": "spinner"
	},
	"footer": {
		"max_lines": 2,
		"segments": [
			"cwd",
			"git",
			"ctx",
			"tokens",
			"cost"
		],
		"narrow_segments": [
			"cwd",
			"git",
			"ctx",
			"tokens",
			"cost"
		],
		"style": {
			"workspace_color": "accent",
			"git_color": "success"
		}
	},
	"tools": {
		"expanded_default": false,
		"show_timing": true,
		"show_provider": false,
		"max_target_chars": 72,
		"max_summary_chars": 96,
		"collapsed_lines": 2
	},
	"banner": {
		"enabled": true,
		"style": "ascii",
		"layout": "auto",
		"side_by_side_min_width": 96,
		"tiny_width": 44,
		"show_hints": true,
		"show_capabilities": true,
		"clear_on_first_turn": false
	},
	"math": {
		"enabled": true,
		"max_width_cells": 120,
		"max_height_cells": 18,
		"svg_scale": 2,
		"foreground": "#d4d4d4"
	}
}