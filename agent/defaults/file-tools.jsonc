{
	"$schema": "../schemas/file-tools.schema.json",

	// 硬阻止：不能直接访问，也不会出现在 ls 结果中。
	"blocked_path": [
		".git/",
		"~/.ssh/id_ed25519"
	],

	// 软忽略：ls/read 标记 ignored；不阻止显式 read/edit。
	"ignored_path": [
		".venv/",
		"venv/",
		"node_modules/"
	],

	"limits": {
		"ls_entries": 200,
		"read_lines": 3000,
		"read_bytes": 51200,
		"read_max_file_bytes": 16777216,
		"read_suggestion_limit": 3,
		"write_max_file_bytes": 16777216,
		"edit_max_file_bytes": 16777216,
		"edit_match_hint_limit": 5,
		"find_output_token_budget": 1000,
		"find_result_limit": 80,
		"find_max_depth": 12,
		"grep_max_depth": 12,
		"grep_ast_max_file_bytes": 262144,
		"grep_output_token_budget": 4000,
		"grep_result_limit": 24
	},

	"ignore": {
		"piignore": true,
		"gitignore": true,
		"git_tracked_files_bypass": true,
		"builtin_profile": "minimal"
	}
}
