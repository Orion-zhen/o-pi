{
	"enabled": true,
	"exclude_paths": ["~"],
	"startup_timeout_ms": 8000,
	"request_timeout_ms": 5000,
	"idle_timeout_ms": 300000,
	"max_restarts": 2,
	// 仓库配置覆盖内置默认值 64。
	"max_open_documents": 128,

	"diagnostics": {
		"enabled": true,
		"max_wait_ms": 3000,
		"settle_ms": 150,
		"max_items": 8,
		"min_severity": "warning"
	},

	"read": {
		"outline": true,
		"max_symbols": 40
	},

	"grep": {
		"workspace_symbols": true,
		"references": false,
		"max_symbols": 20,
		"max_references": 20
	},

	"servers": {
		"typescript": {
			"command": ["typescript-language-server", "--stdio"],
			"languages": {
				"typescript": "*.ts",
				"typescriptreact": "*.tsx",
				"javascript": "*.{js,mjs,cjs}",
				"javascriptreact": "*.jsx"
			}
		},
		"python": {
			"command": ["pyright-langserver", "--stdio"],
			"languages": { "python": "*.{py,pyi}" }
		},
		"rust": {
			"command": ["rust-analyzer"],
			"languages": { "rust": "*.rs" }
		},
		"clangd": {
			"command": ["clangd"],
			"languages": {
				"c": "*.c",
				"cpp": "*.{C,h,hh,hpp,hxx,cc,cpp,cxx}"
			}
		},
		"docker": {
			"command": ["docker-language-server", "start", "--stdio"],
			"languages": {
				"dockerfile": [
					"{Dockerfile,Containerfile}",
					"?*.{Dockerfile,Containerfile}",
					"{Dockerfile,Containerfile}.?*"
				],
				"dockercompose": [
					"{compose,docker-compose}.{yaml,yml}",
					"{compose,docker-compose}.?*.{yaml,yml}"
				]
			}
		},
		"yaml": {
			"fallback": true,
			"command": ["yaml-language-server", "--stdio"],
			"languages": { "yaml": "*.{yaml,yml}" }
		}

		// TCP example: uncomment and replace the endpoint with a user-provided server.
		// ,"remote-example": {
		// 	"tcp": { "host": "127.0.0.1", "port": 2087 },
		// 	"languages": { "remote": "*.remote" }
		// }
	}
}
